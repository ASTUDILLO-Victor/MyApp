Producto producto1 = new Producto();
producto1.Nombre = "Laptop";
producto1.Precio = 999.99;
producto1.Stock = 10;

Producto producto2 = new Producto();
producto2.Nombre = "Smartphone";
producto2.Precio = 499.99;
producto2.Stock = 20;

Console.WriteLine(producto1.MostrarInfo());
Console.WriteLine(producto2.MostrarInfo());
class Producto
{
    public string Nombre = "";
    public double Precio = 0;
    public int Stock = 0;

    public string MostrarInfo()
    {
        string info = $"Nombre: {Nombre}\n Precio: {Precio}\n Stock: {Stock}";
        return info;
    }

}